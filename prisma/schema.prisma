// 1. Configuración de la Base de Datos (PostgreSQL)
datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// 2. Configuración del Cliente de Prisma
generator client {
  provider = "prisma-client-js"
}

// --- 3. Nuestras Tablas (Modelos) ---

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String?
  role  Role   @default(ENGINEER)

  workerId String  @unique
  password String?

  logs Log[]
}

model Tool {
  id     String @id @default(cuid())
  name   String
  qrId   String @unique
  status Status @default(AVAILABLE)

  isCalibrationTool   Boolean   @default(false)
  nextCalibrationDate DateTime?

  logs Log[]
}

model Log {
  id          String   @id @default(cuid())
  type        LogType
  createdAt   DateTime @default(now())
  clientJobId String?
  comments    String?

  // --- Carta Responsiva (aplica solo a CHECK_OUT) ---
  // Se guarda la versión del texto vigente al momento del préstamo,
  // de manera que cualquier cambio futuro al texto legal no afecte
  // los registros históricos.
  responsivaAccepted Boolean @default(false)
  responsivaVersion  String?

  userId String
  user   User   @relation(fields: [userId], references: [id])
  toolId String
  tool   Tool   @relation(fields: [toolId], references: [id])

  @@index([userId])
  @@index([toolId])
}

// --- 4. Tipos Especiales (Enums) ---
enum Role {
  ADMIN
  ENGINEER
}

enum Status {
  AVAILABLE
  IN_USE
}

enum LogType {
  CHECK_OUT
  CHECK_IN
}